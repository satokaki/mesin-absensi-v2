{
  "name": "Absensi",
  "type": "object",
  "properties": {
    "kode_absensi": { "type": "string" },
    "company_id": { "type": "string" },
    "company_nama": { "type": "string" },
    "cabang_id": { "type": "string" },
    "cabang_nama": { "type": "string" },
    "shift_id": { "type": "string" },
    "shift_nama": { "type": "string" },
    "titik_absensi_id": { "type": "string" },
    "titik_absensi_nama": { "type": "string" },
    "karyawan_id": {
      "type": "string"
    },
    "karyawan_nama": {
      "type": "string"
    },
    "nik": {
      "type": "string"
    },
    "tanggal": {
      "type": "string",
      "format": "date"
    },
    "jenis": {
      "type": "string",
      "enum": [
        "hadir",
        "terlambat",
        "izin",
        "sakit",
        "cuti",
        "alfa"
      ],
      "default": "hadir"
    },
    "check_in": {
      "type": "string",
      "format": "date-time"
    },
    "check_out": {
      "type": "string",
      "format": "date-time"
    },
    "lokasi_check_in": {
      "type": "string"
    },
    "lokasi_check_out": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "latitude_check_in": { "type": "number" },
    "longitude_check_in": { "type": "number" },
    "akurasi_check_in": { "type": "number" },
    "jarak_check_in": { "type": "number" },
    "selfie_check_in_url": { "type": "string" },
    "latitude_check_out": { "type": "number" },
    "longitude_check_out": { "type": "number" },
    "akurasi_check_out": { "type": "number" },
    "jarak_check_out": { "type": "number" },
    "selfie_check_out_url": { "type": "string" },
    "status_approval": { "type": "string", "enum": ["pending", "disetujui", "ditolak"], "default": "pending" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "alasan_approval": { "type": "string" },
    "foto_url": {
      "type": "string"
    },
    "catatan": {
      "type": "string"
    },
    "durasi_kerja": {
      "type": "number"
    }
  },
  "required": [
    "karyawan_id",
    "tanggal"
  ]
}

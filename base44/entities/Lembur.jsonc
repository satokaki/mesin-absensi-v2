{
  "name": "Lembur",
  "type": "object",
  "properties": {
    "kode_lembur": { "type": "string" },
    "company_id": { "type": "string" },
    "company_nama": { "type": "string" },
    "karyawan_id": {
      "type": "string"
    },
    "karyawan_nama": {
      "type": "string"
    },
    "tanggal": {
      "type": "string",
      "format": "date"
    },
    "jam_mulai": {
      "type": "string"
    },
    "jam_selesai": {
      "type": "string"
    },
    "durasi_jam": {
      "type": "number",
      "default": 0
    },
    "alasan": {
      "type": "string"
    },
    "tarif_per_jam": {
      "type": "number",
      "default": 0
    },
    "total_upah": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "disetujui",
        "ditolak",
        "selesai"
      ],
      "default": "pending"
    },
    "disetujui_oleh": {
      "type": "string"
    }
  },
  "required": [
    "karyawan_id",
    "tanggal",
    "jam_mulai",
    "jam_selesai"
  ]
}
